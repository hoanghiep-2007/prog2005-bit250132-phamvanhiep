#include <iostream>
using namespace std;

int timMax(int a[], int n) {
    int max = a[0];

    for (int i = 1; i < n; i++) {
        if (a[i] > max) {
            max = a[i];
        }
    }

    return max;
}

int main() {
    int n;

    cout << "Nhap so phan tu: ";
    cin >> n;

    int a[100];

    for (int i = 0; i < n; i++) {
        cout << "a[" << i << "] = ";
        cin >> a[i];
    }

    cout << "Gia tri lon nhat: " << timMax(a, n);

    return 0;
}
